---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Blog — Workgraph" description="Updates, technical deep dives, and design philosophy from the Workgraph project.">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-16">
    <header class="mb-10">
      <h1 class="text-3xl md:text-5xl font-bold text-zinc-50 leading-tight mb-4">Blog</h1>
      <p class="text-lg text-text-secondary">
        Updates, technical deep dives, and design philosophy from the Workgraph project.
      </p>
    </header>

    <hr class="gradient-divider" />

    <div class="mt-8">
      {posts.length === 0 && (
        <p class="text-text-tertiary py-8">No posts yet. Check back soon.</p>
      )}
      {posts.map((post) => (
        <BlogCard
          title={post.data.title}
          description={post.data.description}
          date={post.data.date}
          readTime={post.data.readTime}
          slug={post.id.replace(/\.md$/, '')}
          tags={post.data.tags}
        />
      ))}
    </div>
  </div>
</BaseLayout>
