---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/features/', label: 'Features' },
  { href: '/quickstart/', label: 'Quickstart' },
  { href: '/manual/', label: 'Manual' },
  { href: '/theory/', label: 'Theory' },
  { href: '/docs/', label: 'Docs' },
  { href: '/blog/', label: 'Blog' },
];

function isActive(href: string, current: string): boolean {
  if (href === '/') return current === '/';
  return current.startsWith(href);
}
---

<header class="border-b border-border-primary bg-bg-primary/80 backdrop-blur-sm sticky top-0 z-50">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2 flex items-center justify-between">
    <a href="/" class="text-base font-semibold text-zinc-50 hover:text-accent-primary transition-colors font-mono">
      wg
    </a>
    <!-- Hamburger button (mobile) -->
    <button
      id="nav-toggle"
      class="md:hidden text-text-secondary hover:text-text-primary transition-colors"
      aria-label="Toggle navigation"
      aria-expanded="false"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path id="hamburger-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        <path id="close-icon" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    <!-- Desktop nav -->
    <div class="hidden md:flex items-center gap-x-4">
      {navLinks.map(({ href, label }) => (
        <a
          href={href}
          class:list={[
            'text-xs transition-colors',
            isActive(href, currentPath)
              ? 'text-text-primary'
              : 'text-text-secondary hover:text-text-primary',
          ]}
        >
          {label}
        </a>
      ))}
      <a
        href="https://github.com/graphwork/wg"
        class="text-xs text-text-secondary hover:text-text-primary transition-colors"
        target="_blank"
        rel="noopener noreferrer"
      >
        GitHub
      </a>
    </div>
  </nav>
  <!-- Mobile nav drawer -->
  <div id="nav-drawer" class="hidden md:hidden border-t border-border-primary px-4 py-3">
    <div class="flex flex-col gap-2">
      {navLinks.map(({ href, label }) => (
        <a
          href={href}
          class:list={[
            'text-sm transition-colors py-1',
            isActive(href, currentPath)
              ? 'text-text-primary'
              : 'text-text-secondary hover:text-text-primary',
          ]}
        >
          {label}
        </a>
      ))}
      <a
        href="https://github.com/graphwork/wg"
        class="text-sm text-text-secondary hover:text-text-primary transition-colors py-1"
        target="_blank"
        rel="noopener noreferrer"
      >
        GitHub
      </a>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const drawer = document.getElementById('nav-drawer');
  const hamburger = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  toggle?.addEventListener('click', () => {
    const open = drawer?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
    hamburger?.classList.toggle('hidden', open);
    closeIcon?.classList.toggle('hidden', !open);
  });
</script>
