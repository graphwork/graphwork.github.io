---
interface Props {
  title: string;
  description: string;
  date: Date;
  readTime?: string;
  slug: string;
  tags?: string[];
}

const { title, description, date, readTime, slug, tags = [] } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<a href={`/blog/${slug}/`} class="block blog-card group">
  <div class="blog-card-meta mb-2">
    <time datetime={date.toISOString()}>{formattedDate}</time>
    {readTime && <span class="mx-2">&middot;</span>}
    {readTime && <span>{readTime}</span>}
  </div>
  <h2 class="text-xl sm:text-2xl font-semibold text-zinc-100 blog-card-title transition-colors mb-2">
    {title}
  </h2>
  <p class="text-text-secondary leading-relaxed text-sm sm:text-base">{description}</p>
  {tags.length > 0 && (
    <div class="flex flex-wrap gap-2 mt-3">
      {tags.map((tag) => (
        <span class="text-xs font-mono px-2 py-0.5 rounded-md bg-bg-tertiary text-text-tertiary">
          {tag}
        </span>
      ))}
    </div>
  )}
</a>
