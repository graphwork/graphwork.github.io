---
import GradientDivider from './GradientDivider.astro';
---

<footer class="mt-24 pb-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <GradientDivider />
    <div class="mt-8 flex items-center justify-between text-sm text-text-tertiary">
      <span>&copy; {new Date().getFullYear()} Workgraph</span>
      <a
        href="https://github.com/graphwork/workgraph"
        class="hover:text-text-secondary transition-colors"
      >
        GitHub
      </a>
    </div>
  </div>
</footer>
