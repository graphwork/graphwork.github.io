---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'wg documentation' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const currentPath = Astro.url.pathname;

const sidebarLinks = [
  { href: '/docs/', label: 'Overview' },
  { href: '/docs/getting-started/', label: 'Getting Started' },
  { href: '/docs/workflow-patterns/', label: 'Workflow Patterns' },
  { href: '/docs/verification/', label: 'Verification' },
  { href: '/docs/service/', label: 'Service Management' },
  { href: '/docs/agency/', label: 'Agency System' },
  { href: '/docs/tui/', label: 'TUI Guide' },
  { href: '/docs/commands/', label: 'Command Reference' },
  { href: '/docs/ai-integration/', label: 'AI Integration' },
];

function isActive(href: string, current: string): boolean {
  if (href === '/docs/') return current === '/docs/' || current === '/docs';
  return current.startsWith(href);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Inter + JetBrains Mono: self-hosted, declared in global.css -->
  </head>
  <body>
    <Header currentPath={Astro.url.pathname} />
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-16 flex gap-10">

      <!-- Sidebar -->
      <nav class="docs-sidebar">
        <h3 class="text-xs font-semibold text-text-tertiary uppercase tracking-wider mb-4 font-mono">Documentation</h3>
        <ul class="space-y-1">
          {sidebarLinks.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class:list={[
                  'docs-nav-link',
                  isActive(href, currentPath) && 'active',
                ]}
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Content -->
      <article class="docs-content flex-1 min-w-0">
        <slot />
      </article>

    </div>
    <Footer />
  </body>
</html>

<style>
  .docs-sidebar {
    width: 14rem;
    flex-shrink: 0;
    position: sticky;
    top: 5rem;
    max-height: calc(100vh - 6rem);
    overflow-y: auto;
  }

  .docs-sidebar::-webkit-scrollbar {
    width: 3px;
  }

  .docs-sidebar::-webkit-scrollbar-thumb {
    background: var(--color-border-primary);
    border-radius: 3px;
  }

  @media (max-width: 1023px) {
    .docs-sidebar {
      display: none;
    }
  }

  .docs-nav-link {
    display: block;
    padding: 0.375rem 0.75rem;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    border-radius: 0.375rem;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .docs-nav-link:hover {
    color: var(--color-text-primary);
    background: var(--color-bg-tertiary);
  }

  .docs-nav-link.active {
    color: var(--color-accent-primary);
    background: rgba(139, 92, 246, 0.1);
  }

  .docs-content {
    max-width: 48rem;
  }
</style>
