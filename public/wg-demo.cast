[15.109, "o", "\u001b[H\u001b[2J$ wg viz\n\u001b[32mdesign-api\u001b[39m  (done) \u001b[90m11m\u001b[39m\n\u001b[90m\u251c\u2192\u001b[39m \u001b[32mbuild-auth\u001b[39m  (done) \u001b[90m11m\u001b[39m \u001b[90m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\u001b[39m\n\u001b[90m\u251c\u2192\u001b[39m \u001b[32msetup-db\u001b[39m  (done) \u001b[90m11m\u001b[39m               \u001b[90m\u2502\u001b[39m\n\u001b[90m\u2502\u001b[39m \u001b[90m\u251c\u2192\u001b[39m \u001b[33mrecipe-crud\u001b[39m  (in-progress) \u001b[90m11m\u001b[39m \u001b[90m\u2500\u2500\u2524\u001b[39m \u001b[90m\u2500\u2500\u2510\u001b[39m\n\u001b[90m\u2502\u001b[39m \u001b[90m\u251c\u2192\u001b[39m \u001b[37msearch\u001b[39m  (open) \u001b[90m11m\u001b[39m \u001b[90m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\u001b[39m \u001b[90m\u2500\u2500\u2524\u001b[39m\n\u001b[90m\u2502\u001b[39m \u001b[90m\u2502\u001b[39m \u001b[90m\u2514\u2192\u001b[39m \u001b[37mdeploy\u001b[39m  (open) \u001b[90m11m\u001b[39m \u001b[90m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u001b[39m \u001b[90m\u2500\u2500\u253c\u001b[39m \u001b[90m\u2190\u2500\u2510\u001b[39m\n\u001b[90m\u2502\u001b[39m \u001b[90m\u2514\u2192\u001b[39m \u001b[37mapi-docs\u001b[39m  (open) \u001b[90m11m\u001b[39m \u001b[90m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u001b[39m \u001b[90m\u2190\u2500\u2518\u001b[39m \u001b[90m\u2500\u2500\u2524\u001b[39m\n\u001b[90m\u2514\u2192\u001b[39m \u001b[37mint-tests\u001b[39m  (open) \u001b[90m11m\u001b[39m \u001b[90m\u2190\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\u001b[39m \u001b[90m\u2500\u2500\u2500\u2500\u2500\u2500\u2518\u001b[39m\n\n\u001b[2mLegend: \u253c = crossing (vertical arc passes through horizontal)\u001b[0m\n$\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n"]
