u2500\u2510\n\u2502\u001b[38;5;8m \u001b[1m\u001b[38;5;3m0:Chat\u001b[0m\u001b[38;5;8m \u2502 1:Detail \u2502 2:Log \u2502 3:Msg \u2502 4:Agency \u2502 5:Con\u001b[38;5;6m\u2502\n\u2502\u001b[39m \u001b[1m\u001b[38;5;6m \u25c9\u001b[38;5;15m Coordinator 0\u001b[0m \u001b[38;5;8m\u2502 \u25cf Coordinator 1\u001b[38;5;1m \u2715\u001b[39m \u001b[38;5;8m\u2502 \u25cf Coordinator\u001b[38;5;6m\u2502\n\u2502\u001b[39m  pressing \u001b[38;5;222m\u001b[48;5;236m X \u001b[39m\u001b[49m first, then swiping vertically to     \u001b[38;5;6m\u2502\n\u2502\u001b[39m  scroll horizontally.                               \u001b[38;5;6m\u2502\n\u2502\u001b[39m                                                     \u001b[38;5;6m\u2502\n\u2502\u001b[39m  If that workaround doesn't feel right, I can       \u001b[38;5;6m\u2502\n\u2502\u001b[39m  create a follow-up task to explore alternatives \u2014  \u001b[38;5;6m\u2502\n\u2502\u001b[39m  for example:                                       \u001b[38;5;6m\u2502\n\u2502\u001b[39m                                                     \u001b[38;5;6m\u2502\n\u2502\u001b[39m  1. \u001b[1mTwo-finger horizontal scroll\u001b[0m (if Termux passes  \u001b[38;5;6m\u2502\n\u2502\u001b[39m  that through)                                      \u001b[38;5;6m\u2502\n\u2502\u001b[39m  2. \u001b[1mArrow keys / h/l keys\u001b[0m for horizontal panning    \u001b[38;5;6m\u2502\n\u2502\u001b[39m  without needing the toggle                         \u001b[38;5;6m\u2502\n\u2502\u001b[39m  3. \u001b[1mTap-on-edge zones\u001b[0m \u2014 tapping the left/right      \u001b[38;5;6m\u2502\n\u2502\u001b[39m  edges to pan                                       \u001b[38;5;6m\u2502\n\u2502\u001b[39m                                                     \u001b[38;5;6m\u2502\n\u2502\u001b[39m  Want me to queue up a better solution, or does the \u001b[38;5;6m\u2502\n\u2502\u001b[39m  \u001b[38;5;222m\u001b[48;5;236mX \u001b[39m\u001b[49m toggle just need to be more discoverable?       \u001b[38;5;6m\u2502\n\u2502\u001b[39m                                                     \u001b[38;5;6m\u2502\n\u2502\u001b[38;5;8m \u2191\u2193: scroll\u001b[39m                                          \u001b[38;5;6m\u2502\n\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\n\u001b[1m\u001b[38;5;15m\u001b[48;2;30;30;30m Graph\u001b[0m\u001b[38;2;80;80;80m\u001b[48;2;30;30;30m | \u001b[1m\u001b[38;2;120;120;120mNAV\u001b[0m\u001b[38;2;80;80;80m\u001b[48;2;30;30;30m | \u001b[38;5;3m\u2191\u2193\u001b[38;2;140;140;140m:select  \u001b[38;5;3mEnter\u001b[38;2;140;140;140m:inspect  \u001b[38;5;3mTab\u001b[38;2;140;140;140m:panel  \u001b[38;2;80;80;80m\u2026\u001b[39m\n"]
[16.657, "o", "\u001b[H\u001b[2J\u001b[38;5;15m\u001b[48;5;8m 2157 tasks (2148 done, 6 open, 2 active\u001b[38;5;1m, 1 fail\u001b[38;5;2m\u001b[48;2;20;50;20m \u25cf\u001b[38;5;15m 2/8\n\u001b[38;5;3m\u001b[49m\u25b2\u001b[38;5;6m\u2192\u001b[39m \u001b[38;5;2mdoc-refresh-mar21-ds4-doc-sync-ds3-ds2-doc-sync-com\u25b2\n\u001b[38;5;6m\u251c\u2192\u001b[39m \u001b[38;5;2mdoc-refresh-mar21-ds4-doc-sync-ds3-ds2-doc-sync-man\u001b[38;5;15m\u2588\n\u001b[38;5;6m\u251c\u2192\u001b[39m \u001b[38;5;2mdoc-refresh-mar21-ds4-doc-sync-ds3-ds2-doc-sync-qui\u001b[38;5;8m\u2551\n\u001b[38;5;6m\u251c\u2192\u001b[39m \u001b[38;5;2mdoc-refresh-mar21-ds4-doc-sync-ds3-ds2-doc-sync-rea\u001b[38;5;8m\u2551\n\u001b[38;5;6m\u251c\u2192\u001b[39m \u001b[38;5;2mdoc-refresh-mar21-ds4-doc-sync-ds3-ds2-doc-sync-ski\u001b[38;5;8m\u2551\n\u001b[38;5;6m\u2514\u2192\u001b[39m \u001b[38;5;2mdoc-refresh-mar21-ds4-doc-sync-ds3-ds2-doc-sync-int\u001b[38;5;8m\u2551\n\u001b[39m  \u001b[38;5;6m\u251c\u2192\u001b[39m \u001b[38;5;2mdoc-refresh-mar21-ds4-doc-sync-ds3-ds2-doc-sync-e\u001b[38;5;8m\u2551\n\u001b[39m  \u001b[38;5;6m\u251c\u2192\u001b[39m \u001b[38;5;2mdoc-refresh-mar21-update-manual-typ\u001b[39m  (done \u00b7 \u2192201\u001b[38;5;8m\u2551\n\u001b[39m  \u001b[38;5;6m\u2514\u2192\u001b[39m \u001b[38;5;2mwebsite-update-spec\u001b[39m  (done \u00b7 \u2192497k \u2190384 \u25ce3.8M \u00a77.\u001b[38;5;8m\u2551\n\u001b[39m    \u001b[38;5;6m\u251c\u2192\u001b[39m \u001b[38;5;2mwebsite-update-docs-render\u001b[39m  (done \u00b7 \u2192102k \u2190253 \u001b[38;5;8m\u2551\n\u001b[39m    \u001b[38;5;6m\u251c\u2192\u001b[39m \u001b[38;5;2mwebsite-update-index\u001b[39m  (done \u00b7 \u2192145k \u2190455 \u25ce1.9M \u25bc\n\u001b[38;5;6m\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2