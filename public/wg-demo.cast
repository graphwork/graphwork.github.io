[21.466, "o", "\u001b[H\u001b[2J\u001b[38;5;15m\u001b[48;5;8m 2149 tasks (2141 done, 6 open, 1 active\u001b[38;5;1m, 1 fail\u001b[38;5;3m\u001b[48;2;50;50;10m \u25cf\u001b[38;5;15m 1/8\n\u001b[38;5;3m\u001b[49m\u25b2\u001b[38;5;6m\u2192\u001b[39m \u001b[38;5;2mdoc-refresh-mar21-ds4-doc-sync-ds3-ds2-doc-sync-qui\u25b2\n\u001b[38;5;6m\u251c\u2192\u001b[39m \u001b[38;5;2mdoc-refresh-mar21-ds4-doc-sync-ds3-ds2-doc-sync-rea\u001b[38;5;15m\u2588\n\u001b[38;5;6m\u251c\u2192\u001b[39m \u001b[38;5;2mdoc-refresh-mar21-ds4-doc-sync-ds3-ds2-doc-sync-ski\u001b[38;5;8m\u2551\n\u001b[38;5;6m\u2514\u2192\u001b[39m \u001b[38;5;2mdoc-refresh-mar21-ds4-doc-sync-ds3-ds2-doc-sync-int\u001b[38;5;8m\u2551\n\u001b[39m  \u001b[38;5;6m\u251c\u2192\u001b[39m \u001b[38;5;2mdoc-refresh-mar21-ds4-doc-sync-ds3-ds2-doc-sync-e\u001b[38;5;8m\u2551\n\u001b[39m  \u001b[38;5;6m\u251c\u2192\u001b[39m \u001b[38;5;2mdoc-refresh-mar21-update-manual-typ\u001b[39m  (done \u00b7 \u2192201\u001b[38;5;8m\u2551\n\u001b[39m  \u001b[38;5;6m\u2514\u2192\u001b[39m \u001b[38;5;2mwebsite-update-spec\u001b[39m  (done \u00b7 \u2192497k \u2190384 \u25ce3.8M \u00a77.\u001b[38;5;8m\u2551\n\u001b[39m    \u001b[38;5;6m\u251c\u2192\u001b[39m \u001b[38;5;2mwebsite-update-docs-render\u001b[39m  (done \u00b7 \u2192102k \u2190253 \u001b[38;5;8m\u2551\n\u001b[39m    \u001b[38;5;6m\u251c\u2192\u001b[39m \u001b[38;5;2mwebsite-update-index\u001b[39m  (done \u00b7 \u2192145k \u2190455 \u25ce1.9M \u001b[38;5;8m\u2551\n\u001b[39m    \u001b[38;5;6m\u251c\u2192\u001b[39m \u001b[38;5;2mwebsite-update-integrate\u001b[39m  (done \u00b7 \u2192201k \u2190332 \u25ce2\u001b[38;5;8m\u2551\n\u001b[39m    \u001b[38;5;6m\u2502\u001b[39m \u001b[38;5;6m\u2514\u2192\u001b[39m \u001b[38;5;2mwebsite-update-refine\u001b[39m  (done \u00b7 \u2192172k \u2190344 \u25ce1.\u25bc\n\u001b[38;5;6m\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\n\u2502\u001b[38;5;8m \u001b[1m\u001b[38;5;3m0:Chat\u001b[0m\u001b[38;5;8m \u2502 1:Detail \u2502 2:Log \u2502 3:Msg \u2502 4:Agency \u2502 5:Con\u001b[38;5;6m\u2502\n\u2502\u001b[39m \u001b[1m\u001b[38;5;6m \u25c9\u001b[38;5;15m Coordinator 0\u001b[0m \u001b[38;5;8m\u2502 \u25cf Coordinator 1\u001b[38;5;1m \u2715\u001b[39m \u001b[38;5;8m\u2502 \u25cf Coordinator\u001b[38;5;6m\u2502\n\u2502\u001b[39m  The previous agent couldn't drive keystrokes into  \u001b[38;5;6m\u2502\n\u2502\u001b[39m  a full-screen ratatui app, so it cheated. With     \u001b[38;5;6m\u2502\n\u2502\u001b[39m  tmux, you can:                                     \u001b[38;5;6m\u2502\n\u2502\u001b[39m                                                     \u001b[38;5;6m\u2502\n\u2502\u001b[39m  1. Run the \u001b[1mreal \u001b[0m\u001b[38;5;222m\u001b[48;5;236m wg tui \u001b[39m\u001b[49m in a tmux session         \u001b[38;5;6m\u2502\n\u2502\u001b[39m  2. Script keystrokes with \u001b[38;5;222m\u001b[48;5;236m tmux send-keys\u001b[39m\u001b[49m          \u001b[38;5;6m\u2502\n\u2502\u001b[39m  (navigate tasks, type to coordinator, etc.)        \u001b[38;5;6m\u2502\n\u2502\u001b[39m  3. asciinema captures the actual terminal output \u2014 \u001b[38;5;6m\u2502\n\u2502\u001b[39m  real box-drawing characters, real task IDs, real   \u001b[38;5;6m\u2502\n\u2502\u001b[39m  everything                                         \u001b[38;5;6m\u2502\n\u2502\u001b[39m                                                     \u001b[38;5;6m\u2502\n\u2502\u001b[39m  The task includes building a \u001b[38;5;222m\u001b[48;5;236m record-real-tui.sh\u001b[39m\u001b[49m   \u001b[38;5;6m\u2502\n\u2502\u001b[39m  script so it's reproducible, not a one-off. Should \u001b[38;5;6m\u2502\n\u2502\u001b[39m  produce a much more impressive demo \u2014 actual live  \u001b[38;5;6m\u2502\n\u2502\u001b[39m  workgraph with 2000+ real tasks, not ASCII         \u001b[38;5;6m\u2502\n\u2502\u001b[39m  theater. \ud83c\udfad\u2192\ud83d\udda5\ufe0f                                     \u001b[38;5;6m\u2502\n\u2502\u001b[39m                                                     \u001b[38;5;6m\u2502\n\u2502\u001b[38;5;8m \u2191\u2193: scroll\u001b[39m                                          \u001b[38;5;6m\u2502\n\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\n\u001b[1m\u001b[38;5;15m\u001b[48;2;30;30;30m Graph\u001b[0m\u001b[38;2;80;80;80m\u001b[48;2;30;30;30m | \u001b[1m\u001b[38;2;120;120;120mNAV\u001b[0m\u001b[38;2;80;80;80m\u001b[48;2;30;30;30m | \u001b[38;5;3m\u2191\u2193\u001b[38;2;140;140;140m:select  \u001b[38;5;3mEnter\u001b[38;2;140;140;140m:inspect  \u001b[38;5;3mTab\u001b[38;2;140;140;140m:panel  \u001b[38;2;80;80;80m\u2026\u001b[39m\n"]
