[4.62, "o", "\u001b[H\u001b[2J\u001b[1;1H$ wg viz\u001b[2;1H\u001b[32mdesign-api\u001b[39m  (done) \u001b[90m1h\u001b[39m\u001b[3;1H\u001b[90m\u251c\u2192\u001b[39m \u001b[32mbuild-auth\u001b[39m  (done) \u001b[90m1h\u001b[39m \u001b[90m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\u001b[39m\u001b[4;1H\u001b[90m\u251c\u2192\u001b[39m \u001b[32msetup-db\u001b[39m  (done) \u001b[90m1h\u001b[39m               \u001b[90m\u2502\u001b[39m\u001b[5;1H\u001b[90m\u2502\u001b[39m \u001b[90m\u251c\u2192\u001b[39m \u001b[33mrecipe-crud\u001b[39m  (in-progress) \u001b[90m1h\u001b[39m \u001b[90m\u2500\u2500\u2524\u001b[39m \u001b[90m\u2500\u2500\u2510\u001b[39m\u001b[6;1H\u001b[90m\u2502\u001b[39m \u001b[90m\u251c\u2192\u001b[39m \u001b[37msearch\u001b[39m  (open) \u001b[90m1h\u001b[39m \u001b[90m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\u001b[39m \u001b[90m\u2500\u2500\u2524\u001b[39m\u001b[7;1H\u001b[90m\u2502\u001b[39m \u001b[90m\u2502\u001b[39m \u001b[90m\u2514\u2192\u001b[39m \u001b[37mdeploy\u001b[39m  (open) \u001b[90m1h\u001b[39m \u001b[90m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u001b[39m \u001b[90m\u2500\u2500\u253c\u001b[39m \u001b[90m\u2190\u2500\u2510\u001b[39m\u001b[8;1H\u001b[90m\u2502\u001b[39m \u001b[90m\u2514\u2192\u001b[39m \u001b[37mapi-docs\u001b[39m  (open) \u001b[90m1h\u001b[39m \u001b[90m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u001b[39m \u001b[90m\u2190\u2500\u2518\u001b[39m \u001b[90m\u2500\u2500\u2524\u001b[39m\u001b[9;1H\u001b[90m\u2514\u2192\u001b[39m \u001b[37mint-tests\u001b[39m  (open) \u001b[90m1h\u001b[39m \u001b[90m\u2190\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\u001b[39m \u001b[90m\u2500\u2500\u2500\u2500\u2500\u2500\u2518\u001b[39m\u001b[10;1H\u001b[11;1H\u001b[2mLegend: \u253c = crossing (vertical arc passes through horizontal)\u001b[0m\u001b[12;1H$"]
